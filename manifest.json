{
  "manifest_version": 3,
  "name": "码藏 - 飞书/生财有术/X长文导出 Markdown PDF",
  "short_name": "码藏",
  "version": "0.3.0",
  "description": "一键把飞书文档、生财有术帖子、X 长文导出为 Markdown / HTML / Word / PDF，支持批量导出与转存飞书。本机处理，不上传。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "码藏（点击打开侧边栏）",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "scripting",
    "downloads",
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.feishu.net/*",
    "https://*.feishu-pre.net/*",
    "https://*.larkoffice.com/*",
    "https://*.larksuite.com/*",
    "https://*.larkenterprise.com/*",
    "https://scys.com/*",
    "https://*.scys.com/*",
    "https://*.shengcaiyoushu.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://*.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/*",
        "https://*.feishu.net/*",
        "https://*.feishu-pre.net/*",
        "https://*.larkoffice.com/*",
        "https://*.larksuite.com/*",
        "https://*.larkenterprise.com/*",
        "https://scys.com/*",
        "https://*.scys.com/*",
        "https://*.shengcaiyoushu.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["src/content/floating-button.css"],
      "run_at": "document_idle"
    }
  ]
}
